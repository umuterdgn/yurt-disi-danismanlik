generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                      String                   @id @default(cuid())
  email                   String                   @unique
  password                String
  name                    String
  role                    UserRole
  isApproved              Boolean                  @default(false)
  isActive                Boolean                  @default(true)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  organizationId          String?
  subscriptionEndsAt      DateTime?
  studentQuota            Int                      @default(30)
  isSubscriptionActive     Boolean                  @default(true)
  aiUsageCount            Int                      @default(0)
  advisorProfile          AdvisorProfile?
  participantAppointments AppointmentParticipant[]
  createdAppointments     Appointment[]            @relation("AppointmentCreator")
  auditLogs               AuditLog[]
  notifications           Notification[]
  parentProfile           ParentProfile?
  childrenAsParent        Parent[]                 @relation("ParentRelations")
  studentProfile          StudentProfile?
  organization            Organization?            @relation(fields: [organizationId], references: [id])

  @@map("users")
}

model StudentProfile {
  id                   String             @id @default(cuid())
  userId               String             @unique
  grade                String
  school               String?
  targetScore          Float?
  currentScore         Float?
  serviceType          ServiceType        @default(BOTH)
  xp                   Int                @default(0)
  studentSymbol        String             @default("🎓")
  streak               Int                @default(0)
  lastLoginDate        DateTime?
  badges               String[]           @default([])
  targetExam           String?
  examDate             DateTime?
  advisorNote          String?
  pomodoroDuration     Int                @default(25)
  healthScore          Int                @default(100)
  riskStatus           String             @default("GREEN")
  applicationReadiness Int                @default(0)
  lastActivityDate     DateTime?
  advisorId            String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  domain               YKSDomain?
  targetUniversities   String[]
  targetUniversity     String?           // Specific target university
  targetMajor         String?           // Target major/program
  learningDNA          Json?             // Learning DNA: { preferredLearningStyle, peakFocusTime, failedStrategies }
  aiRecommendations    AIRecommendation[]
  applications         Application[]
  dailyTasks           DailyTask[]
  examResults          ExamResult[]
  exams                Exam[]
  financePackage       FinancePackage?
  meetingNotes         MeetingNote[]
  parentRelations      Parent[]           @relation("StudentProfile")
  questProgress        QuestProgress[]
  advisor              AdvisorProfile?    @relation(fields: [advisorId], references: [id])
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  studySessions        StudySession[]     @relation("StudentStudySessions")
  subjectAnalysis      SubjectAnalysis[]
  tasks                Task[]
  weeklyCheckIns       WeeklyCheckIn[]
  parentProfiles       ParentProfile[]    @relation("StudentParents")
  worksheets           Worksheet[]
  simulationProfile    SimulationProfile?

  @@map("student_profiles")
}

model AdvisorProfile {
  id                String             @id @default(cuid())
  userId            String             @unique
  specialization    String?
  experience        Int?
  bio               String?
  maxStudents       Int                @default(20)
  advisorType       String             @default("BOTH")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  aiRecommendations AIRecommendation[]
  leads             Lead[]             @relation("LeadAdvisor")
  students          StudentProfile[]
  tasks             Task[]

  @@map("advisor_profiles")
}

model ParentProfile {
  id         String           @id @default(cuid())
  userId     String           @unique
  occupation String?
  address    String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  students   StudentProfile[] @relation("StudentParents")

  @@map("parent_profiles")
}

model Parent {
  id               String         @id @default(cuid())
  parentUserId     String
  studentProfileId String
  relationship     String
  createdAt        DateTime       @default(now())
  parent           User           @relation("ParentRelations", fields: [parentUserId], references: [id], onDelete: Cascade)
  studentProfile   StudentProfile @relation("StudentProfile", fields: [studentProfileId], references: [id], onDelete: Cascade)

  @@unique([parentUserId, studentProfileId])
  @@map("parents")
}

model DailyTask {
  id                 String         @id @default(cuid())
  studentProfileId   String
  title              String
  description        String?
  subject            String         // Keep for backward compatibility
  subjectId          String?        // Reference to Curriculum Subject
  topic              String?        // Keep for backward compatibility
  topicId            String?        // Reference to Curriculum Topic
  questionTypeId     String?        // Reference to Curriculum QuestionType
  targetQuantity     Int
  estimatedPomodoros Int            @default(0)
  completedQuantity  Int            @default(0)
  isCompleted        Boolean        @default(false)
  taskDate           DateTime
  priority           String         @default("medium")
  status             TaskStatus     @default(TODO)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  correctCount       Int?           @default(0)
  wrongCount         Int?           @default(0)
  emptyCount         Int?           @default(0)
  taskType           TaskType       @default(OTHER)
  studyMethod        String?        // "VIDEO", "READING", "PRACTICE", "TEST"
  feedback           String?        // Student feedback: "EASY", "HARD", "MODERATE"
  feedbackNotes      String?        // Additional feedback notes
  studentProfile     StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  curriculumSubject  Subject?       @relation("TaskSubject", fields: [subjectId], references: [id])
  curriculumTopic    Topic?         @relation("TaskTopic", fields: [topicId], references: [id])
  curriculumQuestionType QuestionType? @relation("TaskQuestionType", fields: [questionTypeId], references: [id])
  studySessions      StudySession[] @relation("TaskStudySessions")

  @@map("daily_tasks")
}

model StudySession {
  id               String         @id @default(cuid())
  studentProfileId String
  taskId           String?
  subject          String?
  startTime        DateTime
  endTime          DateTime?
  pauseCount       Int            @default(0)
  actualDuration   Int?
  status           String         @default("IN_PROGRESS")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  studentProfile   StudentProfile @relation("StudentStudySessions", fields: [studentProfileId], references: [id], onDelete: Cascade)
  task             DailyTask?     @relation("TaskStudySessions", fields: [taskId], references: [id])

  @@map("study_sessions")
}

model Task {
  id               String          @id @default(cuid())
  studentProfileId String
  advisorId        String?
  title            String
  description      String?
  status           TaskStatus      @default(TODO)
  dueDate          DateTime?
  subject          String?
  priority         String          @default("medium")
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  advisor          AdvisorProfile? @relation(fields: [advisorId], references: [id])
  studentProfile   StudentProfile  @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  @@map("tasks")
}

model Exam {
  id               String          @id @default(cuid())
  studentProfileId String
  title            String
  date             DateTime
  totalNet         Float?
  totalScore       Float?
  examType         String?
  advisorComments  String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  analysisStatus   String?         @default("pending")
  answerKey        Json?
  ocrConfidence    Float?
  ocrProcessed     Boolean         @default(false)
  ocrStatus        String?
  studentProfile   StudentProfile  @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  subjectResults   SubjectResult[]

  @@map("exams")
}

model SubjectResult {
  id              String           @id @default(cuid())
  examId          String
  subjectName     String
  correct         Int              @default(0)
  wrong           Int              @default(0)
  empty           Int              @default(0)
  net             Float?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  questionResults QuestionResult[]
  exam            Exam             @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@map("subject_results")
}

enum QuestionResultStatus {
  CORRECT
  WRONG
  EMPTY
  UNCERTAIN
}

enum CognitiveErrorType {
  KNOWLEDGE_GAP
  LOGIC_ERROR
  CALCULATION_ERROR
}

enum QuestionStructureType {
  YENI_NESIL
  KLASIK
  ONCULLU
  GRAFIK_TABLO
  PARAGRAF
}

enum DifficultyLevel {
  KOLAY
  ORTA
  ZOR
  AYIRT_EDICI
}

model QuestionResult {
  id               String              @id @default(cuid())
  subjectResultId  String
  subjectResult   SubjectResult      @relation(fields: [subjectResultId], references: [id], onDelete: Cascade)

  questionNumber   Int
  subject          String
  questionText     String?             @db.Text
  markedAnswer     String?
  correctAnswer    String?
  result           QuestionResultStatus // "correct", "wrong", "empty", "uncertain"
  confidence       Float?              // 0.0-1.0
  needsReview      Boolean             @default(false)
  
  topic             String?             // Türev, İntegral vb.
  subTopic         String?
  learningOutcome  String?
  errorType         CognitiveErrorType? // Bilgi Eksikliği, Mantık Hatası, İşlem Hatası
  questionStructure QuestionStructureType? // Yeni Nesil, Klasik, Öncüllü, Grafik/Tablo, Paragraf
  difficultyLevel   DifficultyLevel?    // Kolay, Orta, Zor, Ayırt Edici
  isBlank           Boolean             @default(false) // Boş mu bırakıldı
  interdisciplinaryTag String?          // Kök neden başka ders/konu ise (Örn: 'Matematik - Trigonometri')
  timeSpent         Int                 @default(0) // saniye

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("question_results")
}

model ExamResult {
  id               String         @id @default(cuid())
  studentProfileId String
  examName         String
  examType         String
  examDate         DateTime
  targetScore      Float
  actualScore      Float?
  scoreDifference  Float?
  turkishScore     Float?
  mathScore        Float?
  scienceScore     Float?
  socialScore      Float?
  notes            String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  @@map("exam_results")
}

model SubjectAnalysis {
  id               String           @id @default(cuid())
  studentProfileId String
  subject          String
  topic            String
  proficiency      ProficiencyLevel
  progressPercent  Int              @default(0)
  lastStudiedAt    DateTime?
  totalHours       Int              @default(0)
  dataSource       String           @default("BOTH") // "EXAM", "TASK", "BOTH"
  
  // Holistic Analysis Data Sources
  examNetScore     Float?           // Net score from exams
  examTotalQuestions Int?          // Total questions from exams
  examCorrect      Int?             // Correct answers from exams
  taskNetScore     Float?           // Net score from tasks
  taskTotalQuestions Int?          // Total questions from tasks
  taskCorrect      Int?             // Correct answers from tasks
  totalPomodoroMinutes Int?        // Total focus time in minutes
  studyMethods     String[]         @default([]) // ["VIDEO", "PRACTICE", "TEST", "READING"]
  
  // References to Curriculum
  subjectId        String?          // Reference to Curriculum Subject
  topicId          String?          // Reference to Curriculum Topic
  
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  studentProfile   StudentProfile   @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  @@unique([studentProfileId, subject, topic])
  @@map("subject_analysis")
}

model MeetingNote {
  id               String         @id @default(cuid())
  studentProfileId String
  meetingDate      DateTime
  duration         Int
  motivationLevel  String
  issues           String?
  achievements     String?
  actionItems      String?
  nextMeetingDate  DateTime?
  notes            String
  aiSummary        String?
  aiDecisions      String?
  aiActions        String?
  aiProcessedAt    DateTime?
  tasksGenerated   Boolean        @default(false)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  @@map("meeting_notes")
}

model Country {
  id           String       @id @default(cuid())
  name         String       @unique
  code         String       @unique
  slug         String       @unique
  flag         String?
  currency     String?
  language     String?
  visaRequired Boolean      @default(true)
  averageCost  Float?
  pageContent  String?
  coverImage   String?
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  universities University[]

  @@map("countries")
}

model University {
  id                  String        @id @default(cuid())
  countryId           String
  name                String
  city                String?
  ranking             Int?
  type                String?
  tuitionFees         Float?
  languageRequirement String?
  requiredScore       Float?
  website             String?
  description         String?
  departments         String[]
  applicationDeadline DateTime?
  requirements        String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  baseScore           Float?
  applications        Application[]
  country             Country       @relation(fields: [countryId], references: [id], onDelete: Cascade)

  @@map("universities")
}

model Application {
  id               String            @id @default(cuid())
  studentProfileId String
  universityId     String
  universityName   String?
  country          String?
  program          String
  semester         String
  year             Int
  status           ApplicationStatus @default(LEAD)
  applicationDate  DateTime?
  decisionDate     DateTime?
  deadline         DateTime?
  estimatedBudget  Float?
  actualBudget     Float?
  languageTest     String?
  languageScore    Float?
  notes            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  studentProfile   StudentProfile    @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  university       University        @relation(fields: [universityId], references: [id], onDelete: Cascade)
  documents        Document[]
  visaProcesses    VisaProcess[]

  @@map("applications")
}

model VisaProcess {
  id               String      @id @default(cuid())
  applicationId    String
  status           String      @default("NOT_STARTED")
  appointmentDate  DateTime?
  missingDocuments String[]    @default([])
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  application      Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("visa_processes")
}

model Document {
  id             String         @id @default(cuid())
  applicationId  String
  documentType   String
  documentName   String
  filePath       String?
  isUploaded     Boolean        @default(false)
  uploadDate     DateTime?
  expiryDate     DateTime?
  status         DocumentStatus @default(PENDING)
  feedback       String?
  responsibility String?        @default("STUDENT")
  aiCheckStatus  Boolean        @default(false)
  aiCheckDate    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  application    Application    @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("documents")
}

model Appointment {
  id                String                   @id @default(cuid())
  creatorId         String
  title             String
  description       String?
  appointmentType   String
  startTime         DateTime
  endTime           DateTime
  location          String?
  zoomMeetingId     String?
  zoomMeetingUrl    String?
  zoomPassword      String?
  googleEventId     String?
  googleCalendarUrl String?
  status            String                   @default("scheduled")
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  participants      AppointmentParticipant[]
  creator           User                     @relation("AppointmentCreator", fields: [creatorId], references: [id], onDelete: Cascade)

  @@map("appointments")
}

model AppointmentParticipant {
  id            String      @id @default(cuid())
  appointmentId String
  userId        String
  status        String      @default("accepted")
  attended      Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([appointmentId, userId])
  @@map("appointment_participants")
}

model Notification {
  id                String           @id @default(cuid())
  userId            String
  title             String
  message           String
  type              NotificationType
  isRead            Boolean          @default(false)
  relatedEntityType String?
  relatedEntityId   String?
  createdAt         DateTime         @default(now())
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model AIRecommendation {
  id              String               @id @default(cuid())
  studentId       String
  advisorId       String?
  type            AIRecommendationType
  message         String
  suggestedAction String
  isResolved      Boolean              @default(false)
  priority        String               @default("MEDIUM")
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  advisor         AdvisorProfile?      @relation(fields: [advisorId], references: [id], onDelete: Cascade)
  student         StudentProfile       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("ai_recommendations")
}

model WeeklyCheckIn {
  id               String         @id @default(cuid())
  studentProfileId String
  stressLevel      Int
  motivationLevel  Int
  notes            String?
  weekNumber       Int
  year             Int
  createdAt        DateTime       @default(now())
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  @@unique([studentProfileId, weekNumber, year])
  @@map("weekly_check_ins")
}

model SimulationProfile {
  id                   String          @id @default(cuid())
  studentProfileId     String          @unique
  targetUniversity     String?         // Hedef üniversite
  burnoutRiskScore     Int             @default(0) // Tükenmişlik Skoru 0-100
  ghostCompetitorGap   Float?          // Gölge rakibe olan uzaklık (net farkı)
  lastUpdated          DateTime        @default(now())
  simulationData       Json?           // Ek simülasyon verileri
  studentProfile       StudentProfile  @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  @@map("simulation_profiles")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  details    String?
  ipAddress  String?
  userAgent  String?
  timestamp  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

model SystemSettings {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("system_settings")
}

model ActivityLog {
  id          String   @id @default(cuid())
  userId      String?
  action      String
  entityType  String
  entityId    String?
  description String?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@map("activity_logs")
}

model Lead {
  id                String          @id @default(cuid())
  name              String
  email             String          @unique
  phone             String?
  source            LeadSource
  service           LeadService
  status            LeadStatus      @default(NEW)
  notes             String?
  assignedAdvisorId String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  assignedAdvisor   AdvisorProfile? @relation("LeadAdvisor", fields: [assignedAdvisorId], references: [id])

  @@map("leads")
}

model Organization {
  id        String   @id @default(cuid())
  name      String   @unique
  logo      String?
  domain    String?  @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]

  @@map("organizations")
}

model FinancePackage {
  id               String         @id @default(cuid())
  studentProfileId String         @unique
  packageName      String
  totalAmount      Float
  paidAmount       Float          @default(0)
  currency         String         @default("TRY")
  discount         Float?         @default(0)
  status           String         @default("ACTIVE")
  paymentMethod    String?
  paymentDate      DateTime?
  notes            String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  installments     Installment[]

  @@map("finance_packages")
}

model Installment {
  id               String         @id @default(cuid())
  financePackageId String
  amount           Float
  dueDate          DateTime
  paidDate         DateTime?
  status           String         @default("PENDING")
  paymentMethod    String?
  notes            String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  financePackage   FinancePackage @relation(fields: [financePackageId], references: [id], onDelete: Cascade)

  @@map("installments")
}

model Workflow {
  id          String           @id @default(cuid())
  name        String
  description String?
  trigger     WorkflowTrigger
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  actions     WorkflowAction[]

  @@map("workflows")
}

model WorkflowAction {
  id         String             @id @default(cuid())
  workflowId String
  actionType WorkflowActionType
  payload    String
  order      Int                @default(0)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  workflow   Workflow           @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@map("workflow_actions")
}

model Quest {
  id            String          @id @default(cuid())
  title         String
  description   String
  xpReward      Int
  targetCount   Int
  type          QuestType
  difficulty    String          @default("MEDIUM")
  isActive      Boolean         @default(true)
  startDate     DateTime
  endDate       DateTime
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  questProgress QuestProgress[]

  @@map("quests")
}

model QuestProgress {
  id               String         @id @default(cuid())
  questId          String
  studentProfileId String
  currentCount     Int            @default(0)
  isCompleted      Boolean        @default(false)
  completedAt      DateTime?
  xpAwarded        Boolean        @default(false)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  quest            Quest          @relation(fields: [questId], references: [id], onDelete: Cascade)
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  @@unique([questId, studentProfileId])
  @@map("quest_progress")
}

enum UserRole {
  SUPER_ADMIN
  ADVISOR
  STUDENT
  PARENT
}

enum ServiceType {
  COACHING
  STUDY_ABROAD
  BOTH
}

enum YKSDomain {
  SAYISAL
  SOZEL
  ESIT_AGIRLIK
  DIL
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum TaskType {
  TEST
  REVIEW
  READING
  VIDEO
  PRACTICE
  PROJECT
  EXAM
  OTHER
}

enum ProficiencyLevel {
  WEAK
  MEDIUM
  GOOD
  EXCELLENT
}

enum ApplicationStatus {
  LEAD
  SUBMITTED
  OFFER
  DEPOSIT
  VISA
  ENROLLED
  REJECTED
}

enum DocumentStatus {
  PENDING
  APPROVED
  REVISION_REQUIRED
  MISSING
  UPLOADED
  REJECTED
}

enum NotificationType {
  TASK
  DOCUMENT
  NOTE
  MEETING
  GENERAL
  VISA_APPOINTMENT
  MISSING_DOCUMENT
  APPLICATION_UPDATE
  MEETING_REMINDER
  PAYMENT_REMINDER
}

enum AIRecommendationType {
  RISK
  ACADEMIC
  APPLICATION
}

enum LeadStatus {
  NEW
  CONTACTED
  MEETING_SET
  WON
  LOST
}

enum LeadSource {
  INSTAGRAM
  WEBSITE
  REFERRAL
  FACEBOOK
  TWITTER
  LINKEDIN
  GOOGLE
  OTHER
}

enum LeadService {
  YKS
  STUDY_ABROAD
  LANGUAGE_SCHOOL
  CONSULTING
  OTHER
}

enum WorkflowTrigger {
  NEW_STUDENT
  DOC_REJECTED
  APPLICATION_STATUS_CHANGE
  TASK_COMPLETED
  MEETING_COMPLETED
  PAYMENT_OVERDUE
  RISK_STATUS_CHANGE
}

enum WorkflowActionType {
  CREATE_TASK
  SEND_WHATSAPP
  SEND_EMAIL
  ASSIGN_ADVISOR
  UPDATE_STATUS
  CREATE_NOTIFICATION
  TRIGGER_AI_ANALYSIS
}

enum QuestType {
  POMODORO
  TASK
  EXAM
  STUDY_TIME
  DOCUMENT_UPLOAD
  MEETING_ATTENDANCE
}

// Curriculum Hierarchy (Ortak Payda)
model GradeLevel {
  id          String    @id @default(cuid())
  name        String    @unique // "9. Sınıf", "10. Sınıf", etc.
  displayName String    // "Lise 9. Sınıf"
  isActive    Boolean   @default(true)
  order       Int       @default(0)
  subjects    Subject[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("grade_levels")
}

model Subject {
  id           String      @id @default(cuid())
  gradeLevelId String
  name         String      // "Türkçe", "Matematik", etc.
  code         String?     // "TR", "MAT", etc.
  displayName  String?     // "Türkçe Dili ve Edebiyatı"
  isActive     Boolean     @default(true)
  order        Int         @default(0)
  gradeLevel   GradeLevel  @relation(fields: [gradeLevelId], references: [id], onDelete: Cascade)
  topics       Topic[]
  dailyTasks   DailyTask[] @relation("TaskSubject")
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([gradeLevelId, name])
  @@map("subjects")
}

model Topic {
  id        String    @id @default(cuid())
  subjectId String
  name      String    // "Türev", "İntegral", "Paragraf", etc.
  code      String?   // "MAT-TU-01", etc.
  isActive  Boolean   @default(true)
  order     Int       @default(0)
  subject   Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  questionTypes QuestionType[]
  dailyTasks DailyTask[] @relation("TaskTopic")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([subjectId, name])
  @@map("topics")
}

model QuestionType {
  id        String      @id @default(cuid())
  topicId   String
  name      String      // "Klasik", "Çoktan Seçmeli", "Boşluk Doldurma"
  code      String?     // "KLASIK", "CS", "BD"
  isActive  Boolean     @default(true)
  order     Int         @default(0)
  topic     Topic       @relation(fields: [topicId], references: [id], onDelete: Cascade)
  dailyTasks DailyTask[] @relation("TaskQuestionType")
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([topicId, name])
  @@map("question_types")
}

model Worksheet {
  id                    String         @id @default(cuid())
  studentProfileId      String
  subject               String         // "Türkçe", "Matematik", etc.
  topic                 String         // "Türev", "İntegral", etc.
  correct               Int            @default(0)
  wrong                 Int            @default(0)
  empty                 Int            @default(0)
  questionTypeAnalysis  Json           // JSON object with question type breakdown
  ocrProcessed          Boolean        @default(false)
  ocrConfidence         Float?
  ocrStatus             String?
  notes                 String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  studentProfile        StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  @@map("worksheets")
}
